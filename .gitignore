gitignore
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor

# Environment files
.env
.env.*
!.env.example

# Laravel runtime files
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php

# IDE and local development
/.fleet
/.idea
/.vscode

# Local logs and test results
npm-debug.log
yarn-error.log
.phpunit.result.cache
